# Copy to `.env` and fill in. The backend reads these at startup.

# ----- LLM backend ----------------------------------------------------------
# LLM_PROVIDER picks the agent backend: gemini | vllm | ollama.
# Unset → "vllm" if LLM_API_KEY is set, else local "ollama".
# vllm and gemini both use one OpenAI-compatible /chat/completions client.
# LLM_PROVIDER=vllm

# API key for the remote provider (vLLM or Gemini). Presence of this key (with
# no LLM_PROVIDER set) defaults the backend to vllm. GEMINI_API_KEY also works.
# LLM_API_KEY=

# OpenAI-compatible base URL. Defaults per provider:
#   vllm   → http://localhost:8000/v1        (point this at your vLLM server)
#   gemini → https://generativelanguage.googleapis.com/v1beta/openai
# LLM_BASE_URL=

# Model name. Defaults: vllm → Qwen/Qwen2.5-7B-Instruct, gemini → gemini-2.0-flash.
# LLM_MODEL=

# Local Ollama model used by the agent (default: qwen3). Pull it first:
#   ollama pull qwen3
# OLLAMA_MODEL=qwen3

# Optional: Ollama host (default: http://localhost:11434).
# If the chosen LLM backend is unreachable, /api/chat returns an error.
# OLLAMA_HOST=http://localhost:11434

# Optional: backend port (default 8000). Use SERVER_PORT (not PORT) so it
# doesn't collide with react-scripts, which also reads PORT from this file.
# SERVER_PORT=8000

# Frontend: only needed if the backend isn't on http://localhost:8000.
# REACT_APP_API_BASE=http://localhost:8000
